<idea-plugin>
    <id>ink.lipoly.ext.termino</id>
    <name>Termino</name>
    <vendor>LiPolymer</vendor>
    <description><![CDATA[
        Open independent terminal sessions in editor tabs, with configurable startup commands and toolbar icons.
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.terminal</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileEditorProvider id="termino-terminal-editor"
                            implementation="ink.lipoly.ext.termino.EditorTerminalProvider"/>
        <fileIconProvider implementation="ink.lipoly.ext.termino.EditorTerminalIconProvider"/>
        <applicationConfigurable parentId="tools"
                                 instance="ink.lipoly.ext.termino.TerminoSettingsConfigurable"
                                 id="ink.lipoly.ext.termino.TerminoSettingsConfigurable"
                                 displayName="Termino"/>
    </extensions>
    <actions>
        <action id="ink.lipoly.ext.termino.OpenEditorTerminal"
                class="ink.lipoly.ext.termino.OpenEditorTerminalAction"
                text="在编辑器中打开终端"
                description="在编辑器标签页中创建终端会话"
                icon="/icons/terminal.svg">
            <add-to-group group-id="MainToolbarRight" anchor="first"/>
        </action>
    </actions>
</idea-plugin>
